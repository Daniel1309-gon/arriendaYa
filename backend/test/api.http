### SMOKE TEST — Rentia Backend API
### Requiere VS Code REST Client extension o similar (IntelliJ .http, Postman, curl)
### Ejecutar en orden secuencial. Las variables se heredan entre requests.

@base = http://localhost:3000

#############################################
# 1. HEALTH CHECK
#############################################

### GET health
GET {{base}}/health

#############################################
# 2. AUTH — OTP Flow
#############################################

### POST /auth/otp/request — Solicitar código OTP
# El código aparece en la consola del servidor (console.log)
POST {{base}}/auth/otp/request
Content-Type: application/json

{
  "email": "test@rentia.online"
}

### POST /auth/otp/verify — Verificar OTP
# Reemplazar <CODIGO> con el código que apareció en la consola
# Guarda el token en la variable global
POST {{base}}/auth/otp/verify
Content-Type: application/json

{
  "email": "test@rentia.online",
  "codigo": "<CODIGO>"
}

#############################################
# 3. AUTH — Google OAuth (mock / manual)
#############################################

### POST /auth/google — Iniciar sesión con Google
# Requiere un idToken real de Google Identity Services.
# Este endpoint fallará con 401 sin un token válido (esperado).
POST {{base}}/auth/google
Content-Type: application/json

{
  "idToken": "fake-token-for-testing"
}

#############################################
# 4. USUARIOS — Perfil e Historial
#############################################

### GET /usuarios/perfil — Obtener perfil (PROTEGIDO)
# Requiere token JWT del paso 2. Copia y pega el token aquí.
GET {{base}}/usuarios/perfil
Authorization: Bearer {{token}}
Content-Type: application/json

### PUT /usuarios/perfil — Actualizar perfil (PROTEGIDO)
PUT {{base}}/usuarios/perfil
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "telefono": "3001234567",
  "ciudadOrigen": "Bogotá",
  "edad": 30,
  "presupuestoMin": 800000,
  "presupuestoMax": 2500000,
  "zonasInteres": ["chapinero", "usaquen", "cedritos"]
}

### POST /usuarios/historial — Agregar inmueble al historial (PROTEGIDO)
POST {{base}}/usuarios/historial
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "inmuebleId": "mock-finca-1"
}

### POST /usuarios/historial — Agregar otro inmueble (PROTEGIDO)
POST {{base}}/usuarios/historial
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "inmuebleId": "mock-metro-1"
}

### GET /usuarios/historial — Consultar historial (PROTEGIDO)
GET {{base}}/usuarios/historial
Authorization: Bearer {{token}}
Content-Type: application/json

#############################################
# 5. INMUEBLES — CRUD
#############################################

### POST /inmuebles — Crear inmueble propio (PROTEGIDO)
POST {{base}}/inmuebles
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "valorCanon": 1800000,
  "administracionIncluida": true,
  "tamanoM2": 65,
  "habitaciones": 2,
  "banos": 1,
  "patio": false,
  "parqueaderos": 1,
  "antiguedadAnos": 3,
  "estrato": 4,
  "piso": 6,
  "ascensor": true,
  "petFriendly": true,
  "latitud": 4.6483,
  "longitud": -74.0721,
  "url": "https://rentia.online/inmueble-ejemplo"
}

### GET /inmuebles — Listar todos (PÚBLICO, sin token)
GET {{base}}/inmuebles

### GET /inmuebles — Con filtros
GET {{base}}/inmuebles?precioMin=1000000&precioMax=3000000&habitaciones=2&estrato=4

### DELETE /inmuebles/:id — Eliminar inmueble propio (PROTEGIDO)
# Reemplazar <INMUEBLE_ID> con el id del inmueble creado arriba
DELETE {{base}}/inmuebles/<INMUEBLE_ID>
Authorization: Bearer {{token}}

### PUT /inmuebles/:id — Actualizar inmueble (PROTEGIDO)
# Reemplazar <INMUEBLE_ID> con el id del inmueble creado arriba
PUT {{base}}/inmuebles/<INMUEBLE_ID>
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "valorCanon": 2000000,
  "petFriendly": false
}

#############################################
# 6. INMUEBLES — Fotos propias (Cloudinary)
#############################################
# Requiere las tres variables CLOUDINARY_* en backend/.env; sin ellas el POST devuelve 503.
# Los inmuebles scrapeados NO pasan por acá: sus fotos son URLs del CDN del
# portal que guarda el scraper.

### POST /inmuebles/:id/imagenes — Subir fotos (PROTEGIDO, multipart)
# Reemplazar <INMUEBLE_ID> y las rutas de los archivos.
# Máximo 10 por inmueble, 5 MB cada una, JPEG/PNG/WebP.
# El formato se verifica por magic bytes: renombrar un .txt a .png da 415.
POST {{base}}/inmuebles/<INMUEBLE_ID>/imagenes
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=RentiaBoundary

--RentiaBoundary
Content-Disposition: form-data; name="imagenes"; filename="sala.jpg"
Content-Type: image/jpeg

< ./fixtures/sala.jpg
--RentiaBoundary
Content-Disposition: form-data; name="imagenes"; filename="cocina.jpg"
Content-Type: image/jpeg

< ./fixtures/cocina.jpg
--RentiaBoundary--

### DELETE /inmuebles/:id/imagenes — Quitar una foto (PROTEGIDO)
# La URL debe estar en el array del inmueble; si no, 404.
DELETE {{base}}/inmuebles/<INMUEBLE_ID>/imagenes
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "url": "https://res.cloudinary.com/<cloud>/image/upload/v1/rentia/inmuebles/<usuario>/<inmueble>/<id>.jpg"
}

### POST /inmuebles/:id/imagenes — Inmueble de otro usuario (esperado: 403)
POST {{base}}/inmuebles/<INMUEBLE_AJENO_ID>/imagenes
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=RentiaBoundary

--RentiaBoundary
Content-Disposition: form-data; name="imagenes"; filename="sala.jpg"
Content-Type: image/jpeg

< ./fixtures/sala.jpg
--RentiaBoundary--

#############################################
# 7. PROBANDO RUTAS PROTEGIDAS SIN TOKEN (deben devolver 401)
#############################################

### GET /usuarios/perfil — Sin token (esperado: 401)
GET {{base}}/usuarios/perfil

### POST /inmuebles — Sin token (esperado: 401)
POST {{base}}/inmuebles
Content-Type: application/json

{
  "valorCanon": 1000000,
  "administracionIncluida": false,
  "tamanoM2": 50,
  "habitaciones": 1,
  "banos": 1,
  "parqueaderos": 0,
  "antiguedadAnos": 5,
  "estrato": 3,
  "piso": 2,
  "ascensor": false,
  "latitud": 4.6097,
  "longitud": -74.0817
}
