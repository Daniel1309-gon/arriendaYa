PORT=3000                                                                                                                                   
DATABASE_URL="url-de-conexion-a-tu-base-de-datos"                                            
MONGO_URL="url-de-conexion-a-tu-base-de-datos-mongodb"
MONGO_DB="arriendaya_scraper"
MONGO_COLLECTION="inmuebles_scrapeados"
REDIS_URL="url-de-conexion-a-tu-base-de-datos-redis"                                                                                                          
JWT_SECRET="super-secret-key-cambiar-en-produccion"                                                                                         
GOOGLE_CLIENT_ID="tu-google-client-id"
GOOGLE_CLIENT_SECRET="tu-google-client-secret"
RESEND_API_KEY="tu-resend-api-key"
EMAIL_FROM="tu-correo-de-envio"
FRONTEND_URL="http://localhost:5173"
# Opcional: sólo lo necesita POST /inmuebles/:id/imagenes. Sin alguna de estas
# variables el servidor arranca igual y la subida de fotos responde 503.
CLOUDINARY_CLOUD_NAME="tu-cloudinary-cloud-name"
CLOUDINARY_API_KEY="tu-cloudinary-api-key"
CLOUDINARY_API_SECRET="tu-cloudinary-api-secret"
