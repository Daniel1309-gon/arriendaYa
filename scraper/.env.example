MONGO_URL="mongodb://localhost:27017/arriendaya_scraper"
MONGO_DB="arriendaya_scraper"
MONGO_COLLECTION="inmuebles_scrapeados"

# URL de búsqueda de Fincaraiz. Ábrela en el navegador, filtra arriendo de
# apartamentos en Bogotá y copia la URL canónica (sin parámetros de filtro hashed).
FINCARAIZ_BASE_URL="https://www.fincaraiz.com.co/arriendo/apartamentos/bogota-dc"
MAX_PAGINAS=5
# Debe ser mayor que el barrido completo: ceil(páginas/MAX_PAGINAS) * SCRAPE_INTERVAL_HOURS / 24.
INACTIVE_AFTER_DAYS=14
DELAY_MIN_S=2
DELAY_MAX_S=5
HEADLESS=true
SCRAPE_INTERVAL_HOURS=3
MIN_ITEMS_PER_RUN=10
MIN_MAPPED_RATIO=0.25
SCRAPE_LEASE_TTL_S=21600
MAX_CANON_S=50000000
MAX_AREA_M2=2000
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
